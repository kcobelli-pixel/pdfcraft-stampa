+    /// The eframe storage key for the further saved signatures. Official builds rewrite "pdfcraft"
+    /// without them but keep keys they don't know, so the extras survive running one.
+    pub const MORE_SIGNATURES_KEY: &'static str = "pdfcraft_more_signatures";
+
+    /// The further saved signatures and initials, stored under [`Self::MORE_SIGNATURES_KEY`].
+    pub fn persist_more_signatures(&self) -> String {
+        serde_json::json!({ "signatures": self.more_signatures[0], "initials": self.more_signatures[1] }).to_string()
+    }
+
+    /// Reads [`Self::persist_more_signatures`], after [`Self::restore`]. Each entry on its own: a
+    /// damaged image or a non-finite stroke drops only itself. With none in use (an official
+    /// build removed it), the first further one takes its place.
+    pub fn restore_more_signatures(&mut self, json: &str) {
+        let Ok(v) = serde_json::from_str::<serde_json::Value>(json) else { return };
+        for (i, key) in ["signatures", "initials"].into_iter().enumerate() {
+            self.more_signatures[i] = v[key]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|s| serde_json::from_value::<fill_sign::SavedSig>(s.clone()).ok())
+                .filter(|s| !matches!(s, fill_sign::SavedSig::Drawn(st) if st.iter().flatten().flatten().any(|x| !x.is_finite())))
+                .collect();
+            let current = if i == 0 { &mut self.signature } else { &mut self.initials };
+            if current.is_none() && !self.more_signatures[i].is_empty() {
+                *current = Some(self.more_signatures[i].remove(0));
+            }
+        }
+    }
+
